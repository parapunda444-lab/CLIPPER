      "text": "Some mornings ask only that we arrive."
    },
    {
      "id": "demo-caption-02",
      "start": 6.17,
      "end": 10.92,
      "text": "The first light takes its time."
    },
    {
      "id": "demo-caption-03",
      "start": 11.99,
      "end": 16.74,
      "text": "A narrow path is still a way forward."
    },
    {
      "id": "demo-caption-04",
      "start": 17.81,
      "end": 22.56,
      "text": "Clouds loosen their hold, one ridge at a time."
    },
    {
      "id": "demo-caption-05",
      "start": 23.63,
      "end": 28.38,
      "text": "There is room here for a slower thought."
    },
    {
      "id": "demo-caption-06",
      "start": 29.45,
      "end": 34.2,
      "text": "Below, the forest gathers the light."
    },
    {
      "id": "demo-caption-07",
      "start": 35.27,
      "end": 40.02,
      "text": "Every shade of green has somewhere to go."
    },
    {
      "id": "demo-caption-08",
      "start": 41.09,
      "end": 45.84,
      "text": "The canopy rolls on, soft as a held breath."
    },
    {
      "id": "demo-caption-09",
      "start": 46.91,
      "end": 51.66,
      "text": "Even the farthest edge feels close enough."
    },
    {
      "id": "demo-caption-10",
      "start": 52.73,
      "end": 57.48,
      "text": "A little distance can change the day."
    },
    {
      "id": "demo-caption-11",
      "start": 58.55,
      "end": 63.3,
      "text": "We follow the quiet until it opens."
    },
    {
      "id": "demo-caption-12",
      "start": 64.37,
      "end": 69.12,
      "text": "The mountains keep their own time."
    },
    {
      "id": "demo-caption-13",
      "start": 70.19,
      "end": 74.94,
      "text": "A small figure crosses a very wide world."
    },
    {
      "id": "demo-caption-14",
      "start": 76.01,
      "end": 80.76,
      "text": "The ground rises, and the mind softens."
    },
    {
      "id": "demo-caption-15",
      "start": 81.83,
      "end": 86.58,
      "text": "Keep the moment; leave the hurry behind."
    },
    {
      "id": "demo-caption-16",
      "start": 87.65,
      "end": 92.4,
      "text": "There is still time to breathe."
    }
